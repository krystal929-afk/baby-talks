# ── Baby Firefly environment variables ───────────────────────────────────────
# Local dev: copy to .dev.vars (Worker runtime) and .env (Vite build). Never
# commit real values. In production these live in Cloudflare:
#   Workers & Pages > baby-talks > Settings > Variables and Secrets
# (plain vars are also declared in wrangler.jsonc; secrets via
#  `npx wrangler secret put NAME`).

# ── Supabase (project jtymnvlzbabobroabzlf) ──────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SECRET. Server only; bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=""
# Build-time copies for the browser bundle (set as Cloudflare *build* variables).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── AI ───────────────────────────────────────────────────────────────────────
# Baby's chat (OpenRouter). SECRET.
OPENROUTER_API_KEY=""
# CHAT_AI_MODEL="openrouter/free"
# CHAT_AI_URL / CHAT_AI_KEY  — point chat at a different OpenAI-compatible API
# Grow plans, image generation and document writing (Google AI Studio). SECRET.
GEMINI_API_KEY=""
# UTIL_AI_MODEL / UTIL_AI_URL / UTIL_AI_KEY, IMAGE_AI_MODEL, DOCUMENT_AI_MODEL — optional overrides
# Live web search tool (tavily.com). Optional; Baby says search is unavailable without it.
TAVILY_API_KEY=""

# ── Voice (first one that works wins: Azure, ElevenLabs, Workers AI) ─────────
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"
ELEVENLABS_API_KEY=""

# ── Reminders ────────────────────────────────────────────────────────────────
# Needed only for /api/public/hooks/send-due-reminders (push sending from the Worker).
VAPID_PRIVATE_KEY=""
CRON_SECRET=""
# Time zone for reminder text when the browser's zone isn't known.
# APP_TIME_ZONE="America/New_York"
