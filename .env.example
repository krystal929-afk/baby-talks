# ── Baby Talks environment variables ─────────────────────────────────────────
# Copy to .env for local dev. In production (Cloudflare Workers), set these as
# secrets: npx wrangler secret put <NAME>

# Supabase (same values as before — from supabase.com dashboard > project settings > API)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"

# ── AI: Baby's chat (personality) ── default: OpenRouter free model ──────────
# Free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Optional overrides (change model/provider without touching code):
# CHAT_AI_MODEL="x-ai/grok-4.1-fast"        # paid, very permissive, when budget allows
# CHAT_AI_URL="https://openrouter.ai/api/v1/chat/completions"
# CHAT_AI_KEY=""                             # separate key if CHAT_AI_URL is a different provider

# ── AI: utility calls (idea classification + grow packs) ── default: Gemini free tier ──
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional overrides:
# UTIL_AI_MODEL="gemini-2.5-flash"
# UTIL_AI_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
# UTIL_AI_KEY=""

# ── Optional integrations ─────────────────────────────────────────────────────
# Web search for Baby's chat (free plan at tavily.com)
TAVILY_API_KEY=""
# Voice (requires ElevenLabs Starter plan or above for cloned voices; app falls
# back to the browser's built-in voice when unset)
ELEVENLABS_API_KEY=""
# Push notification reminders
VAPID_PRIVATE_KEY=""
# Shared secret protecting the reminder cron endpoint
CRON_SECRET=""
